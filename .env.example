# Copy this file to .env and fill in ONE option. Never commit .env.
# With no LLM settings, the app still works: rules + hybrid search only.
# On Streamlit Cloud, put the same lines in App settings -> Secrets instead.

# --- Option A: Anthropic ---
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-4-5
# ANTHROPIC_API_KEY=sk-ant-...

# --- Option B: any OpenAI-compatible API (OpenAI, Groq free tier, OpenRouter...) ---
# LLM_PROVIDER=openai
# LLM_MODEL=llama-3.1-8b-instant
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=gsk_...

# --- Option C: Ollama on your own computer (free, no key) ---
# LLM_PROVIDER=openai
# LLM_MODEL=llama3.2
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama

# --- Optional: API embeddings instead of the local vectors ---
# EMBED_MODEL=text-embedding-3-small
# EMBED_BASE_URL=https://api.openai.com/v1
# EMBED_API_KEY=sk-...
